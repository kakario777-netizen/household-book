<?xml version="1.0" encoding="utf-8"?>
<!-- 결제 내역은 구글 클라우드 백업에 올리지 않음 (폰 안에만) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
